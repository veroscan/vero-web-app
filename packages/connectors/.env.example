# @vero/connectors. Merge into the root .env.example.
# With no key, a connector returns status "unavailable". That never counts for or against a score.

# live (default) or fixture. Fixture mode serves fictional Kestrel Pay data and is refused when NODE_ENV=production.
CONNECTOR_MODE=live

# Companies House public data API. Sent as the HTTP Basic username.
COMPANIES_HOUSE_API_KEY=

# ICO register of fee payers. The API's reference.refresh job stores a copy from ICO_REGISTER_URL,
# which is read first; this local CSV is used only while no stored copy exists.
ICO_REGISTER_FILE=
ICO_REGISTER_URL=

# HMRC Check a UK VAT number API v2 (OAuth client credentials, scope read:vat).
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# Optional. Use https://test-api.service.hmrc.gov.uk for the sandbox.
HMRC_BASE_URL=

# USPTO. These are two separate keys: TSDR for trademarks, the Open Data Portal for patents.
USPTO_TSDR_API_KEY=
USPTO_ODP_API_KEY=

# SEC EDGAR needs no key, but does need a declared identity: "Company Name admin@company.example".
SEC_USER_AGENT=

# Delaware through a licensed vendor. Never Delaware's own site.
# middesk or cobalt. If unset, uses whichever has a key, Middesk first.
DELAWARE_VENDOR=
MIDDESK_API_KEY=
# Optional. Use https://api-sandbox.middesk.com for the sandbox.
MIDDESK_BASE_URL=
COBALT_API_KEY=

# Nigeria CAC through Mono.
MONO_SECRET_KEY=

# NDPC register JSON feed. The address can rotate, so a job should re-read it from the register page.
NDPC_REGISTER_URL=

# Sanctions lists to screen against: any of ofac,uk,un,fr (fr: the French asset-freeze register).
SANCTIONS_LISTS=

# Identifying user agent for reading a company's own website, including a contact address.
WEB_SCAN_USER_AGENT=

# France (data sources only, see docs/FRANCE.md). Annuaire des Entreprises: no key; a plain User-Agent name.
FR_RECHERCHE_ENTREPRISES_USER_AGENT=
# The CNIL DPO list, downloaded by the API's reference.refresh job. The connector reads only the stored copy.
FR_CNIL_DPO_URL=

# National registers that need a key or account (docs/NATIONAL-REGISTERS.md). Each is off until set.
DK_CVR_USERNAME=
DK_CVR_PASSWORD=
AU_ABR_GUID=
NZ_NZBN_API_KEY=
CA_CORPORATIONS_API_KEY=
NL_KVK_API_KEY=
IE_CRO_EMAIL=
IE_CRO_API_KEY=

# Copy to .env for local development. Scripts and the API fall back to these
# values when .env is missing, unless NODE_ENV=production. In production nothing
# is loaded from files, and the API refuses to start on any of the dev values.

NODE_ENV=development
LOG_LEVEL=info

# ---- API server ----
API_HOST=127.0.0.1
API_PORT=4000
# Public address of this API, used in signed file links.
API_BASE_URL=http://localhost:4000
# Public address of the web app, used in emailed links.
WEB_BASE_URL=http://localhost:3000
# Comma-separated. Browsers on any other origin cannot make state-changing calls.
ALLOWED_ORIGINS=http://localhost:3000
# Only "true" behind a reverse proxy you control, or X-Forwarded-For can be spoofed.
TRUST_PROXY=false
# Must stay true in production.
COOKIE_SECURE=true

# ---- Database ----
# Local embedded Postgres, started with `npm run db:start`. Lives under .data/.
EMBEDDED_PG_PORT=54329
EMBEDDED_PG_SUPERUSER_PASSWORD=dev-only-superuser-password
# Non-superuser role the API connects as. Subject to row-level security.
DATABASE_URL=postgres://vero_app:dev-only-app-password@localhost:54329/vero
# Owns the schema and runs migrations. Never used by the running API.
DATABASE_MIGRATOR_URL=postgres://vero_migrator:dev-only-migrator-password@localhost:54329/vero

# ---- Encryption ----
# 32 bytes, base64. Encrypts TOTP secrets and local files, and signs local file links.
# Generate your own: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=

# ---- Sign-in limits ----
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_MAGIC_LINK_PER_EMAIL_PER_HOUR=5
RATE_LIMIT_MAGIC_LINK_PER_IP_PER_HOUR=30
RATE_LIMIT_VERIFY_PER_IP_PER_15_MIN=30
RATE_LIMIT_TOTP_PER_USER_PER_15_MIN=5
RATE_LIMIT_INVITATIONS_PER_ORG_PER_DAY=50

# ---- Other limits ----
RATE_LIMIT_CHECK_AGAIN_PER_COMPANY_PER_HOUR=6
RATE_LIMIT_REGISTRY_SEARCH_PER_ORG_PER_HOUR=120
RATE_LIMIT_PUBLIC_PER_IP_PER_MINUTE=30
RATE_LIMIT_LOOKUP_REQUESTS_PER_ORG_PER_DAY=20
# Largest upload accepted.
MAX_UPLOAD_MB=25

# ---- Plans. There is no billing provider yet: an admin sets each organisation's plan. ----
# Development only: free, growth or scale for everyone. Production refuses to start with this set.
PLAN_OVERRIDE=


# ---- Email. Without a key, mail goes to the outbox table and the link is logged. ----
# Required in production.
RESEND_API_KEY=
MAIL_FROM=Vero <no-reply@vero.example>

# ---- Job queue. Without this, jobs run in-process. Use Valkey, never Redis 7.4+. ----
VALKEY_URL=

# ---- File storage. Without these, files go encrypted to .data/files. ----
# All four are needed to switch on S3-compatible storage (DigitalOcean Spaces).
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
LOCAL_FILE_DIR=.data/files

# ---- Data sources (@vero/connectors). Without a key a source reports "unavailable", ----
# ---- which never counts for or against a score. ----
# live (default) or fixture. Fixture mode serves fictional data and is refused in production.
CONNECTOR_MODE=live
# How long one source may take before it counts as down for this scan.
CONNECTOR_TIMEOUT_MS=20000
# A worker holds a scan this long. After that, another run may take over.
SCAN_LEASE_SECONDS=300
# First wait before trying a source that was down. It doubles, up to a day.
SOURCE_RETRY_MINUTES=15
# Paid vendors (Middesk, Cobalt, Mono): how many days a good answer is reused before we pay
# for a new one. "Check again" skips it, within RATE_LIMIT_CHECK_AGAIN_PER_COMPANY_PER_HOUR.
# Errors are never reused.
VENDOR_CACHE_DAYS=30
# Development only, refused in production: save every live provider response here, with
# secrets and personal data removed. See docs/RECORDING-REAL-RESPONSES.md.
# `npm run connectors:record` uses packages/connectors/test/recorded/data when this is empty.
CONNECTOR_RECORD_DIR=
# Bodies bigger than this many bytes (such as whole sanctions lists) are not saved. Default 2000000.
CONNECTOR_RECORD_MAX_BYTES=
COMPANIES_HOUSE_API_KEY=
# Path to a downloaded ICO register CSV. Used only while no stored copy exists (see below).
ICO_REGISTER_FILE=
# Where the reference refresh job downloads the ICO register CSV. Not set: the address isn't
# confirmed, and the ICO page refused automated fetches when checked. Owner decision.
ICO_REGISTER_URL=
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_BASE_URL=
USPTO_TSDR_API_KEY=
USPTO_ODP_API_KEY=
# EU trade marks by number (EUIPO Trademark Search API, OAuth client credentials). Free account on
# dev.euipo.europa.eu; the subscription is approved by hand. Off until both are set.
EUIPO_CLIENT_ID=
EUIPO_CLIENT_SECRET=
# Only for the sandbox: https://api-sandbox.euipo.europa.eu/trademark-search and
# https://auth-sandbox.euipo.europa.eu/oidc/accessToken. Empty means production.
EUIPO_BASE_URL=
EUIPO_TOKEN_URL=
# Declared identity SEC EDGAR requires, with a contact address. Sent to the SEC only, never recorded.
SEC_USER_AGENT=
# Licensed Delaware vendor: middesk or cobalt. Never the Delaware state site.
DELAWARE_VENDOR=
MIDDESK_API_KEY=
MIDDESK_BASE_URL=
COBALT_API_KEY=
MONO_SECRET_KEY=
NDPC_REGISTER_URL=
# Any of ofac,uk,un,fr,eu. fr is the French national asset-freeze register (DG Trésor): only its
# entity names are kept, never the people on it.
# eu is the EU consolidated financial sanctions list (European Commission), no key; also only
# entity names are kept. See docs/SECOND-WAVE-SOURCES.md.
SANCTIONS_LISTS=
# Identifying user agent for reading a company website, with a contact address.
WEB_SCAN_USER_AGENT=

# ---- France: data sources only. France is not offered to customers and has no rules yet ----
# ---- (docs/FRANCE.md). Both are off until set. ----
# Annuaire des Entreprises (API Recherche d'entreprises): free, no key, at most 7 requests a second.
# Sent as the User-Agent: a plain name for us, never a person's details, e.g. "VeroScan company checks".
FR_RECHERCHE_ENTREPRISES_USER_AGENT=
# Where the reference refresh job downloads the CNIL list of organisations with a DPO (about 32 MB;
# only SIRENs and designation dates are kept). Not set: the CSV's columns aren't confirmed yet.
# The stable data.gouv.fr link is https://www.data.gouv.fr/api/1/datasets/r/c5d02b42-1008-4406-83f5-3a81c8b936a3
FR_CNIL_DPO_URL=

# ---- Global sources, for a company in any country (docs/GLOBAL-COVERAGE.md). All off until set. ----
# Sent as the User-Agent to the keyless public APIs: GLEIF (LEI records, 60 requests a minute) and
# the EU VIES VAT check. A plain name for us, never a person's details, e.g. "VeroScan company checks".
# Setting it switches both on. Read the VIES terms note in docs/ENGINE-ACCOUNTS-AND-KEYS.md first.
PUBLIC_API_USER_AGENT=
# It also switches on ESMA's prospectus register (eu.esma_prospectus), asked only by the LEI the
# company gives (docs/ENGINE-STATUS.md).
# The same setting also switches on the national registers that need no key: Norway (Brønnøysund),
# Finland (PRH / YTJ), Czechia (ARES), Poland (KRS) and Singapore (ACRA on data.gov.sg). See
# docs/NATIONAL-REGISTERS.md.
# Switzerland's Zefix REST API is free but needs a username and password, given on request by the
# Federal Office of Justice. Off until both are set.
ZEFIX_USERNAME=
ZEFIX_PASSWORD=
# OpenCorporates API token (paid). The fallback register for countries with no register source of
# their own. Licence terms are an owner decision: docs/ENGINE-ACCOUNTS-AND-KEYS.md.
OPENCORPORATES_API_TOKEN=

# ---- National company registers that need a key or account (docs/NATIONAL-REGISTERS.md). ----
# ---- Each is off until set. How to get each: docs/ENGINE-ACCOUNTS-AND-KEYS.md. ----
# Denmark, CVR system-til-system access (free, from Erhvervsstyrelsen): user id and password.
DK_CVR_USERNAME=
DK_CVR_PASSWORD=
# Australia, ABN Lookup web services (free): the GUID emailed after registering.
AU_ABR_GUID=
# New Zealand, NZBN API v5 on api.business.govt.nz (free): the subscription key.
NZ_NZBN_API_KEY=
# Canada, Corporations Canada's Federal Corporation API (ISED API Store, Public Plan): the user-key.
CA_CORPORATIONS_API_KEY=
# Netherlands, KVK API (paid: EUR 6.40 a month plus EUR 0.02 a company profile): the apikey.
NL_KVK_API_KEY=
# Ireland, CRO Open Services (free for searches): the registered email and the API key.
IE_CRO_EMAIL=
IE_CRO_API_KEY=
# Germany, OpenRegister (paid licensed provider for the Handelsregister; free plan 500 credits a
# month, then EUR 0.01 a credit; about 11 credits a lookup): the API key from openregister.de/keys.
OPENREGISTER_API_KEY=

# ---- Stored copies of the public lists (ICO register, NDPC list, OFAC/UK/UN/FR sanctions, CNIL DPO list). ----
# Off until the owner says so: with it off, the reference.refresh jobs download nothing, and the
# three sources behave as before (local ICO file; NDPC and sanctions downloaded during a scan).
# On: each list is asked daily (sanctions every 6 hours) with a conditional GET, and a failed,
# empty or under-half-size download never replaces the last good copy.
REFERENCE_REFRESH_ENABLED=false
# Sent as the User-Agent when downloading the lists. A plain name, no contact details.
REFERENCE_USER_AGENT=VeroScan reference-data refresh
# A stored ICO, NDPC or CNIL copy older than this many hours gives "unavailable", never an answer.
REFERENCE_MAX_AGE_HOURS=48
# A stored sanctions copy older than this gives "unavailable", never "no match".
REFERENCE_SANCTIONS_MAX_AGE_HOURS=24

# ---- Scale monitoring: re-scans on our own, weekly (an assumption: see docs/ENGINE-STATUS.md). ----
# Off until the owner says so: with it off, no monitoring scan is ever queued.
MONITORING_ENABLED=false
# Monitoring scans one organisation can have in a day, and across everyone in a day.
MONITORING_MAX_SCANS_PER_ORG_PER_DAY=20
MONITORING_MAX_SCANS_PER_DAY=500

# ---- Document helper (Claude). Off: the heuristic classifier is used, exactly as before. ----
# Used for an organisation only when ALL hold: this is true, ANTHROPIC_API_KEY is set, and the
# organisation has switched it on for itself (organisation_setting, off by default).
# Keep it OFF for real customer documents until zero data retention is arranged with Anthropic
# (or an EU route via Bedrock or Vertex is chosen) and the AI disclosure is signed. See
# docs/ENGINE-ACCOUNTS-AND-KEYS.md. Everything it says is a suggestion a person confirms.
AI_DOCUMENT_HELPER_ENABLED=false
# Read by the Anthropic SDK itself. Never logged or returned.
ANTHROPIC_API_KEY=
# Owner cost decision. A cheaper tier: claude-sonnet-5-5 or claude-haiku-5-5.
CLAUDE_MODEL=claude-opus-5-5
# low, medium, high, xhigh or max.
DOCUMENT_HELPER_EFFORT=medium
# A PDF with more pages than this is not sent ("too large to read automatically").
DOCUMENT_HELPER_MAX_PAGES=50
# Documents one organisation can have read in a day. After that, the heuristic only.
DOCUMENT_HELPER_MAX_PER_ORG_PER_DAY=100
DOCUMENT_HELPER_TIMEOUT_MS=90000
DOCUMENT_HELPER_MAX_TOKENS=8000
# Not set: whether documents must stay in one region is an open owner decision. When set, it
# is sent as the request's inference_geo.
ANTHROPIC_INFERENCE_GEO=

# ---- GitHub connection (read-only GitHub App) ----
# Off until the owner registers the app (docs/ENGINE-ACCOUNTS-AND-KEYS.md, section 7). It is on
# only when all four of GITHUB_APP_ID, GITHUB_APP_SLUG, the private key and GITHUB_WEBHOOK_SECRET
# are set; otherwise every GitHub route says "not connected yet". None of these is ever logged.
GITHUB_APP_ID=
# The app's name as it appears in its GitHub address (github.com/apps/<slug>).
GITHUB_APP_SLUG=
# Preferred: the path to the .pem file GitHub gave you, kept outside the repository.
GITHUB_APP_PRIVATE_KEY_FILE=
# Or the PEM itself on one line, with each newline written as 
. Set one of the two, not both.
GITHUB_APP_PRIVATE_KEY=
# The secret typed into the app's webhook settings. At least 20 characters.
GITHUB_WEBHOOK_SECRET=
# https only (a localhost address is allowed for development). GitHub Enterprise: its /api/v3 address.
GITHUB_API_URL=https://api.github.com
# Where customers install the app.
GITHUB_WEB_URL=https://github.com
# Repositories one organisation can include.
GITHUB_MAX_REPOS_PER_ORG=25
# File requests per sync, across all repositories (each repository asks for at most 27 allowlisted paths).
GITHUB_MAX_FILES_PER_SYNC=800

# ---- Web app ----
# Where the web server forwards /v1 to reach the API. Read when the web app is built.
# Behind this proxy the API sees the web server's address, so in production set TRUST_PROXY=true
# on the API, or sign-in limits count every visitor as one.
API_INTERNAL_URL=http://127.0.0.1:4000

# ---- DocuSign connection (OAuth, completed envelopes picked by the customer) ----
# Off until both are set (docs/ENGINE-ACCOUNTS-AND-KEYS.md, section 8). Register this redirect URI
# on the integration key exactly: <API_BASE_URL>/v1/connections/docusign/callback. Never logged.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
# demo (DocuSign's developer environment) or production (only after DocuSign's go-live review).
DOCUSIGN_ENV=demo
# How far back the list of completed envelopes looks, and how many it shows (at most 100).
DOCUSIGN_LIST_DAYS=90
DOCUSIGN_MAX_ENVELOPES_LISTED=50
# Envelopes per pick, and per organisation per day.
DOCUSIGN_MAX_ENVELOPES_PER_PULL=10
DOCUSIGN_MAX_ENVELOPES_PER_ORG_PER_DAY=50

# ---- Forwarding by email (Resend receiving) ----
# Off until the domain, the webhook signing secret and a Resend key are all set
# (docs/ENGINE-ACCOUNTS-AND-KEYS.md, section 9). Webhook URL: <API_BASE_URL>/v1/webhooks/inbound-email.
# The domain the private addresses live on, for example in.<your domain>. Its MX records point at Resend.
INBOUND_EMAIL_DOMAIN=
# The signing secret Resend shows for the receiving webhook (starts with whsec_). Never logged.
INBOUND_EMAIL_WEBHOOK_SECRET=
# Optional: a Resend key allowed to read received emails, if RESEND_API_KEY is sending-only.
INBOUND_EMAIL_RESEND_API_KEY=
INBOUND_EMAIL_RESEND_API_URL=https://api.resend.com
# Attachments taken from one email, documents per organisation per day, and all attachments of one email together.
INBOUND_EMAIL_MAX_ATTACHMENTS=10
INBOUND_EMAIL_MAX_DOCUMENTS_PER_ORG_PER_DAY=50
INBOUND_EMAIL_MAX_TOTAL_MB=50

# ---- Google Drive connection (OAuth, Google Picker, drive.file scope only) ----
# Off until all four are set (docs/ENGINE-ACCOUNTS-AND-KEYS.md, section 10). Register this redirect URI
# on the OAuth client exactly: <API_BASE_URL>/v1/connections/google-drive/callback.
GOOGLE_DRIVE_CLIENT_ID=
# Never logged.
GOOGLE_DRIVE_CLIENT_SECRET=
# The browser API key for the Google Picker. Public by design: restrict it to the Picker API and the web app's address.
GOOGLE_PICKER_API_KEY=
# The Google Cloud project number (digits), used as the Picker's app id.
GOOGLE_CLOUD_PROJECT_NUMBER=
# Files per pick, and per organisation per day.
GOOGLE_DRIVE_MAX_FILES_PER_PULL=10
GOOGLE_DRIVE_MAX_FILES_PER_ORG_PER_DAY=50

# ---- SharePoint / OneDrive connection (Microsoft identity platform with PKCE, Microsoft Graph) ----
# Off until both are set (docs/ENGINE-ACCOUNTS-AND-KEYS.md, section 11). Register this redirect URI
# (platform Web) exactly: <API_BASE_URL>/v1/connections/sharepoint/callback.
MICROSOFT_CLIENT_ID=
# A client secret of the app registration. Never logged.
MICROSOFT_CLIENT_SECRET=
# organizations (work or school only), common (adds personal Microsoft accounts), consumers, or one tenant id.
MICROSOFT_TENANT=organizations
# Files.Read (the person's own files) or Files.Read.All (also SharePoint sites and shared files).
MICROSOFT_FILES_SCOPE=Files.Read
# Files per pick, and per organisation per day.
SHAREPOINT_MAX_FILES_PER_PULL=10
SHAREPOINT_MAX_FILES_PER_ORG_PER_DAY=50

# ---- Payments (Stripe). Off until all four are set; then plan changes go through Stripe Checkout. ----
# Until then the billing routes say "Payments aren't switched on yet" and an admin changes plans by hand.
# Prices are read from Stripe by these ids: no amount is ever written in code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
